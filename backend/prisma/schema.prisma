generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  user_id       Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  user_type     String    @db.VarChar(20)
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  faculty       Faculty[]
  students      Student[]
  notifications Notification[]

  @@map("users")
}

model Department {
  dept_id       Int                   @id @default(autoincrement())
  dept_name     String                @unique @db.VarChar(255)
  faculty       Faculty[]
  students      Student[]
  subjects      Subject[]             @relation("SubjectInDept")
  announcements      FacultyAnnouncement[]
  uploaded_schedules UploadedSchedule[]

  @@map("departments")
}

model Faculty {
  faculty_id        Int                   @id @default(autoincrement())
  user_id           Int?
  faculty_name      String                @db.VarChar(255)
  email             String?               @db.VarChar(255)
  dept_id           Int?
  Department        Department?           @relation(fields: [dept_id], references: [dept_id])
  attendance        Attendance[]
  User              User?                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  announcements     FacultyAnnouncement[]
  facultyAttendance FacultyAttendance[]
  leaves            FacultyLeave[]
  notes             FacultyNote[]
  faculty_subjects  FacultySubject[]
  is_timetable_admin Boolean?          @default(false)
  uploaded_schedules UploadedSchedule[]

  @@map("faculty")
}

model Student {
  stud_id     Int          @id @default(autoincrement())
  user_id     Int?
  roll_no     String       @unique @db.VarChar(50)
  stud_name   String       @db.VarChar(255)
  email       String?      @db.VarChar(255)
  semester    String?      @db.VarChar(10)
  division    String?      @db.VarChar(10)
  dept_id     Int?
  Department  Department?  @relation(fields: [dept_id], references: [dept_id])
  attendance  Attendance[]
  enrollments Enrollment[]
  User        User?        @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("students")
}

model Subject {
  subject_id       Int                   @id @default(autoincrement())
  subject_code     String                @unique @db.VarChar(50)
  subject_name     String                @db.VarChar(255)
  semester         String?               @db.VarChar(10)
  dept_id          Int?
  Department       Department?           @relation("SubjectInDept", fields: [dept_id], references: [dept_id])
  credits          Int?
  attendance       Attendance[]
  enrollments      Enrollment[]
  announcements    FacultyAnnouncement[]
  timetable        Schedule[]
  faculty_subjects FacultySubject[]

  @@map("subjects")
}

model FacultySubject {
  faculty_id Int
  subject_id Int
  Faculty    Faculty @relation(fields: [faculty_id], references: [faculty_id], onDelete: Cascade)
  Subject    Subject @relation(fields: [subject_id], references: [subject_id], onDelete: Cascade)

  @@id([faculty_id, subject_id])
  @@map("faculty_subjects")
}

model Enrollment {
  stud_id    Int
  subject_id Int
  Student    Student @relation(fields: [stud_id], references: [stud_id], onDelete: Cascade, onUpdate: NoAction)
  Subject    Subject @relation(fields: [subject_id], references: [subject_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([stud_id, subject_id])
  @@map("enrollments")
}

model Schedule {
  timetable_id Int       @id @default(autoincrement())
  subject_id   Int?
  day_of_week  Int?
  start_time   DateTime? @db.Time(6)
  end_time     DateTime? @db.Time(6)
  room_no      String?   @db.VarChar(50)
  Subject      Subject?  @relation(fields: [subject_id], references: [subject_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([day_of_week])
  @@index([start_time])
  @@map("timetable")
}

model UploadedSchedule {
  schedule_id Int       @id @default(autoincrement())
  dept_id     Int
  semester    String    @db.VarChar(10)
  division    String    @db.VarChar(10)
  file_url    String
  uploaded_by Int?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  is_active   Boolean?  @default(true)
  Department  Department @relation(fields: [dept_id], references: [dept_id])
  Faculty     Faculty?   @relation(fields: [uploaded_by], references: [faculty_id])

  @@map("schedules")
}


model Holiday {
  holiday_id   Int      @id @default(autoincrement())
  holiday_name String?  @db.VarChar(255)
  holiday_date DateTime @unique @db.Date
  year         Int      @default(2026)

  @@map("holidays")
}

model Attendance {
  attendance_id   Int       @id @default(autoincrement())
  stud_id         Int?
  subject_id      Int?
  faculty_id      Int?
  attendance_date DateTime? @db.Date
  status          String    @db.VarChar(20)
  Faculty         Faculty?  @relation(fields: [faculty_id], references: [faculty_id], onDelete: Cascade, onUpdate: NoAction)
  Student         Student?  @relation(fields: [stud_id], references: [stud_id], onDelete: Cascade, onUpdate: NoAction)
  Subject         Subject?  @relation(fields: [subject_id], references: [subject_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([stud_id, subject_id, attendance_date], map: "attendance_unique_marking")
  @@map("attendance")
}

model FacultyAttendance {
  faculty_attendance_id Int       @id @default(autoincrement())
  faculty_id            Int
  attendance_date       DateTime  @db.Date
  check_in_time         DateTime? @db.Time(6)
  check_out_time        DateTime? @db.Time(6)
  status                String    @db.VarChar(20)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  Faculty               Faculty   @relation(fields: [faculty_id], references: [faculty_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([faculty_id, attendance_date])
  @@map("faculty_attendance")
}

model FacultyLeave {
  leave_id   Int       @id @default(autoincrement())
  faculty_id Int
  leave_date DateTime  @db.Date
  reason     String?
  status     String?   @default("pending") @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  Faculty    Faculty   @relation(fields: [faculty_id], references: [faculty_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("faculty_leave")
}

model FacultyNote {
  note_id    Int       @id @default(autoincrement())
  faculty_id Int
  title      String?   @db.VarChar(255)
  content    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  Faculty    Faculty   @relation(fields: [faculty_id], references: [faculty_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("faculty_notes")
}

model FacultyAnnouncement {
  announcement_id Int         @id @default(autoincrement())
  faculty_id      Int
  target_type     String      @db.VarChar(20)
  semester        String?     @db.VarChar(10)
  subject_id      Int?
  dept_id         Int?
  Department      Department? @relation(fields: [dept_id], references: [dept_id])
  title           String?     @db.VarChar(255)
  message         String?
  created_at      DateTime?   @default(now()) @db.Timestamp(6)
  Faculty         Faculty     @relation(fields: [faculty_id], references: [faculty_id], onDelete: Cascade, onUpdate: NoAction)
  Subject         Subject?    @relation(fields: [subject_id], references: [subject_id], onUpdate: NoAction)

  @@map("faculty_announcements")
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  user_id         Int
  User            User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  title           String   @db.VarChar(255)
  message         String
  type            String   @db.VarChar(50)
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamp(6)

  @@map("notifications")
}
